generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  avatarUrl    String?  @map("avatar_url") @db.VarChar(2048)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  ownedProjects      Project[]       @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  projectActivities  ActivityLog[]   @relation("ActivityActor")

  @@map("users")
}

enum ProjectRole {
  OWNER
  MEMBER
}

enum ActivityAction {
  PROJECT_CREATED
  MEMBER_ADDED
  MEMBER_REMOVED
  TASK_CREATED
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  COMMENT_ADDED
  TASK_COMPLETED
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(100)
  description String?         @db.VarChar(2000)
  ownerId     String          @map("owner_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  board       Board?
  activities  ActivityLog[]

  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now()) @map("joined_at")
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Board {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @map("project_id") @db.Uuid
  name      String   @default("Project Board") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("boards")
}

model ActivityLog {
  id        String         @id @default(uuid()) @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  taskId    String?        @map("task_id") @db.Uuid
  actorId   String         @map("actor_id") @db.Uuid
  action    ActivityAction
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at")
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     User           @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([taskId])
  @@index([createdAt])
  @@map("activity_logs")
}
